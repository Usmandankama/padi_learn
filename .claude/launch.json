{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "website", "run", "dev", "--", "--port", "4321"],
      "port": 4321
    },
    {
      "name": "website-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "website", "run", "preview", "--", "--port", "4329"],
      "port": 4329
    },
    {
      "name": "admin",
      "runtimeExecutable": "flutter",
      "runtimeArgs": ["run", "-d", "web-server", "-t", "lib/admin/main.dart", "--web-hostname", "localhost", "--web-port", "5180"],
      "port": 5180
    },
    {
      "name": "web-app-release",
      "runtimeExecutable": "python",
      "runtimeArgs": ["tool/serve_web.py", "8080"],
      "port": 8080
    }
  ]
}
