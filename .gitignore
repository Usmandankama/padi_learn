# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local secrets / credentials (keep out of version control)
lib/firebase_options.dart
lib/config/secrets.dart
lib/config/supabase_config.dart
firebase.json
android/app/google-services.json
google-services.json

# Supabase: migrations and edge functions ARE the schema and belong in the
# repo. Only the CLI's local scratch state is ignored — `/supabase` used to be
# ignored wholesale, which left the database's shape recorded nowhere but the
# remote project.
supabase/.branches/
supabase/.temp/
supabase/**/.env

# Remotion video workspace: source is tracked, dependencies and renders are not.
video/node_modules/
video/out/

# Downloaded audio beds are tracked — they are small and the render needs them.
