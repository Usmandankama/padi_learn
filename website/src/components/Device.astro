---
// A real app screenshot in a plain phone outline. No fake notch or buttons:
// the screenshot already carries the status bar, and the frame stays out of the way.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Rendered width in CSS pixels at its largest, used to pick image sizes. */
  width?: number;
  eager?: boolean;
  class?: string;
}

const { src, alt, width = 300, eager = false, class: className } = Astro.props;
---

<figure class:list={['device', className]} style={`--w: ${width}px`}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    quality={82}
    widths={[width, width * 2]}
    sizes={`(max-width: 640px) 70vw, ${width}px`}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
</figure>

<style>
  .device {
    margin: 0;
    width: min(var(--w), 72vw);
    padding: 7px;
    border-radius: calc(min(var(--w), 72vw) * 0.13);
    background: var(--device);
    box-shadow: 0 1.5rem 3rem -1rem rgb(0 0 0 / 0.25);
  }

  .device :global(img) {
    width: 100%;
    height: auto;
    border-radius: calc(min(var(--w), 72vw) * 0.13 - 7px);
  }
</style>
