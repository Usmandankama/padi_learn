# Copy this file to `.env` in the same folder and fill it in. `.env` is
# git-ignored; it holds passwords and service keys.
#
# Database URLs: Dashboard -> Connect -> "Session pooler". It works over IPv4,
# which the direct connection does not. Put the database password in place of
# [YOUR-PASSWORD], brackets included: they are not part of the password. Forgotten it? Database -> Settings -> Reset database
# password. The apps don't use it, so resetting it breaks nothing.
#
# Service keys: Project Settings -> API Keys. Either the secret key
# (sb_secret_...) or the legacy service_role key works.

OLD_REF=wnxuxplzoddadjpwfhxe
# Paste the whole string from the Connect panel; the pooler host differs by
# project, so don't type it by hand.
OLD_DB_URL=
OLD_SERVICE_KEY=

NEW_REF=
NEW_DB_URL=
NEW_SERVICE_KEY=

# Where dumps are written. They hold every account's email and password hash,
# so keep them out of the repo (which is public) and off shared drives.
DUMP_DIR_ROOT=$HOME/padilearn-backups
