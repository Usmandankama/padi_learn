# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/
.wrangler/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local secrets / credentials (keep out of version control)
lib/firebase_options.dart
lib/config/secrets.dart
lib/config/supabase_config.dart
# The Sentry DSN for hand-made release builds (--dart-define-from-file).
# sentry_dsn.example.json shows the shape; CI reads the SENTRY_DSN secret.
/sentry_dsn.json
firebase.json
android/app/google-services.json

# Android release signing. Losing these locks you out of updating the app
# forever; leaking them lets someone else ship one. The .jks belongs outside
# this repo entirely — key.properties.example shows the shape.
android/key.properties
*.jks
*.keystore
google-services.json

# Supabase: migrations and edge functions ARE the schema and belong in the
# repo. Only the CLI's local scratch state is ignored — `/supabase` used to be
# ignored wholesale, which left the database's shape recorded nowhere but the
# remote project.
supabase/.branches/
supabase/.temp/
supabase/**/.env

# Release APKs staged for upload to R2 — binaries, never committed.
/dist-apk/

# Marketing media (the Remotion workspace and the showreel captures) moved out
# to `Groundwork Tech ltd\Projects\PadiLearn-media` on 2026-10-07. Kept ignored
# so a stray copy can never be committed back into the app repo.
/video
/.assets
